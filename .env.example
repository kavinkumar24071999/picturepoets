# Public site URL, used for link previews. Set this in Vercel after the first deploy.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional. Without these three, the booking form stays in preview mode
# and offers a mailto link instead of sending email.
RESEND_API_KEY=
INQUIRY_TO=hello@picturepoets.com
INQUIRY_FROM=Picture Poets <bookings@yourdomain.com>
